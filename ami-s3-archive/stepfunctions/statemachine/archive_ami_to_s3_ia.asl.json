{
  "Comment": "Archive an EC2 AMI into S3 as a .bin object, convert it to S3 Standard-IA, and optionally deregister the source AMI. Idempotent re-runs resume from existing object or in-progress store tasks; failures trigger best-effort rollback.",
  "StartAt": "PrepareArchive",
  "States": {
    "PrepareArchive": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${HelperLambdaArn}",
        "Payload": {
          "op": "prepare",
          "input.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "Next": "DescribeExistingStoreTask",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "WorkflowFailedNoRollback"
        }
      ]
    },
    "DescribeExistingStoreTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeStoreImageTasks",
      "Parameters": {
        "ImageIds.$": "States.Array($.amiId)"
      },
      "ResultPath": "$.describeTask",
      "Next": "RouteByExistingState",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "RollbackResources"
        }
      ]
    },
    "RouteByExistingState": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.alreadyInTargetStorageClass",
          "BooleanEquals": true,
          "Next": "MaybeCleanupOriginalAmi"
        },
        {
          "Variable": "$.objectExists",
          "BooleanEquals": true,
          "Next": "MarkArchiveReady"
        },
        {
          "Variable": "$.describeTask.StoreImageTaskResults[0].StoreTaskState",
          "StringEquals": "Completed",
          "Next": "MarkArchiveReady"
        },
        {
          "Variable": "$.describeTask.StoreImageTaskResults[0].StoreTaskState",
          "StringEquals": "InProgress",
          "Next": "WaitBeforePolling"
        },
        {
          "Variable": "$.describeTask.StoreImageTaskResults[0].StoreTaskState",
          "StringEquals": "Failed",
          "Next": "ExistingStoreTaskFailed"
        }
      ],
      "Default": "StartStoreImageTask"
    },
    "StartStoreImageTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:createStoreImageTask",
      "Parameters": {
        "ImageId.$": "$.amiId",
        "Bucket.$": "$.bucketName",
        "S3ObjectTags": [
          {
            "Key": "ManagedBy",
            "Value": "StepFunctionsAMIArchive"
          },
          {
            "Key": "SourceAmiId",
            "Value.$": "$.amiId"
          }
        ]
      },
      "ResultPath": "$.storeTask",
      "Next": "MarkStoreTaskStarted",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "RollbackResources"
        }
      ]
    },
    "MarkStoreTaskStarted": {
      "Type": "Pass",
      "Result": true,
      "ResultPath": "$.storeTaskStartedThisRun",
      "Next": "WaitBeforePolling"
    },
    "WaitBeforePolling": {
      "Type": "Wait",
      "SecondsPath": "$.pollSeconds",
      "Next": "PollStoreImageTask"
    },
    "PollStoreImageTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeStoreImageTasks",
      "Parameters": {
        "ImageIds.$": "States.Array($.amiId)"
      },
      "ResultPath": "$.describeTask",
      "Next": "IsStoreImageTaskDone",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "RollbackResources"
        }
      ]
    },
    "IsStoreImageTaskDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.describeTask.StoreImageTaskResults[0].StoreTaskState",
          "StringEquals": "Completed",
          "Next": "MarkArchiveReady"
        },
        {
          "Variable": "$.describeTask.StoreImageTaskResults[0].StoreTaskState",
          "StringEquals": "InProgress",
          "Next": "WaitBeforePolling"
        },
        {
          "Variable": "$.describeTask.StoreImageTaskResults[0].StoreTaskState",
          "StringEquals": "Failed",
          "Next": "StoreImageTaskFailed"
        }
      ],
      "Default": "WaitBeforePolling"
    },
    "MarkArchiveReady": {
      "Type": "Pass",
      "Result": true,
      "ResultPath": "$.archiveObjectReady",
      "Next": "MarkConversionAttempted"
    },
    "MarkConversionAttempted": {
      "Type": "Pass",
      "Result": true,
      "ResultPath": "$.conversionAttempted",
      "Next": "ConvertObjectToStorageClass"
    },
    "ConvertObjectToStorageClass": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${HelperLambdaArn}",
        "Payload": {
          "op": "convert",
          "amiId.$": "$.amiId",
          "bucketName.$": "$.bucketName",
          "objectKey.$": "$.objectKey",
          "storageClass.$": "$.storageClass"
        }
      },
      "ResultSelector": {
        "convert.$": "$.Payload"
      },
      "ResultPath": "$.conversion",
      "Next": "RecordStorageClassChanged",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "RollbackResources"
        }
      ]
    },
    "RecordStorageClassChanged": {
      "Type": "Pass",
      "InputPath": "$.conversion.convert.changed",
      "ResultPath": "$.storageClassChanged",
      "Next": "MaybeCleanupOriginalAmi"
    },
    "MaybeCleanupOriginalAmi": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.cleanupOriginalAmi",
          "BooleanEquals": true,
          "Next": "DeregisterOriginalAmi"
        }
      ],
      "Default": "Success"
    },
    "DeregisterOriginalAmi": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:deregisterImage",
      "Parameters": {
        "ImageId.$": "$.amiId",
        "DeleteAssociatedSnapshots.$": "$.deleteAssociatedSnapshots"
      },
      "ResultPath": "$.cleanup",
      "Next": "Success",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupFailed"
        }
      ]
    },
    "RollbackResources": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${HelperLambdaArn}",
        "Payload": {
          "op": "rollback",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.rollback",
      "Next": "WorkflowFailed",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.rollbackError",
          "Next": "WorkflowFailed"
        }
      ]
    },
    "Success": {
      "Type": "Succeed"
    },
    "ExistingStoreTaskFailed": {
      "Type": "Pass",
      "Next": "RollbackResources"
    },
    "StoreImageTaskFailed": {
      "Type": "Pass",
      "Next": "RollbackResources"
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Error": "WorkflowFailed",
      "Cause": "AMI archive workflow failed after best-effort rollback. Inspect $.rollback.result.actions in the execution history."
    },
    "WorkflowFailedNoRollback": {
      "Type": "Fail",
      "Error": "PrepareFailed",
      "Cause": "Prepare step failed before workflow state was initialized; no rollback performed."
    },
    "CleanupFailed": {
      "Type": "Fail",
      "Error": "CleanupFailed",
      "Cause": "Archive and storage-class conversion succeeded, but AMI deregistration failed. The S3 archive object was preserved."
    }
  }
}
